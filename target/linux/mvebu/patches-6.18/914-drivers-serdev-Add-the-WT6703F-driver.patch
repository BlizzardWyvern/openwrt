--- a/drivers/mfd/Kconfig
+++ b/drivers/mfd/Kconfig
@@ -2458,6 +2458,19 @@ config MFD_IEI_WT61P803_PUZZLE
 	  used for fan control, temperature sensor reading, LED control
 	  and system identification.
 
+config MFD_WD_WT6703F
+	tristate "WD WT6703F MCU support"
+	depends on SERIAL_DEV_BUS
+	select MFD_CORE
+	help
+	  Support for the WD WT6703F MCU found in WD My Cloud devices.
+	  The MCU is connected via UART and controls chassis functions
+	  including status LED, thermal monitoring, and fan control.
+
+	  This driver provides the core MCU communication interface used
+	  by other drivers like the LED, thermal management, RTC, and
+	  fan control drivers.
+
 config MFD_INTEL_M10_BMC_CORE
         tristate
         select MFD_CORE
--- a/drivers/mfd/Makefile
+++ b/drivers/mfd/Makefile
@@ -257,6 +257,7 @@ obj-$(CONFIG_MFD_RT5033)	+= rt5033.o
 obj-$(CONFIG_MFD_RT5120)	+= rt5120.o
 obj-$(CONFIG_MFD_SKY81452)	+= sky81452.o
 obj-$(CONFIG_MFD_IEI_WT61P803_PUZZLE)  += iei-wt61p803-puzzle.o
+obj-$(CONFIG_MFD_WD_WT6703F) 	+= wd-wt6703f.o
 
 obj-$(CONFIG_INTEL_SOC_PMIC)		+= intel_soc_pmic_crc.o
 obj-$(CONFIG_INTEL_SOC_PMIC_BXTWC)	+= intel_soc_pmic_bxtwc.o
